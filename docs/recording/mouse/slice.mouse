# Scripted mouse for the slice reel (--mouse-script); see docs/controls.md
t=0 move 0.5 0.55
t=0 caption Mouse: aim the drop
t=0.2 move 0.43 0.57 over 1.2
t=1.6 caption Left click: drop the fruit
t=1.8 down left
t=1.95 up left
t=2.6 caption Wheel: turn the slice into 4D
t=2.80 scroll 1
t=2.98 scroll 1
t=3.16 scroll 1
t=3.34 scroll 1
t=3.52 scroll 1
t=3.70 scroll 1
t=3.88 scroll 1
t=4.06 scroll 1
t=4.40 scroll -1
t=4.58 scroll -1
t=4.76 scroll -1
t=4.94 scroll -1
t=5.12 scroll -1
t=5.30 scroll -1
t=5.48 scroll -1
t=5.66 scroll -1
t=6.0 caption Right-drag: orbit the camera
t=6.0 move 0.55 0.58 over 0.3
t=6.3 down right
t=6.4 move 0.68 0.52 over 1.0
t=7.5 up right
t=7.7 caption Middle-drag: turn into 4D (or Shift+right-drag)
t=7.7 move 0.5 0.55 over 0.3
t=8.0 down middle
t=8.1 move 0.62 0.5 over 1.2
t=9.3 up middle
t=9.6 caption Shift+wheel: zoom
t=9.6 mods shift
t=9.8 scroll -1
t=10.0 scroll -1
t=10.2 scroll 1
t=10.4 scroll 1
t=10.8 mods none
