# The M key between the views (--mouse-script), and a drop landing on its ghost.
t=0 move 0.5 0.6
t=0 caption The ghost is the real fruit, where it will land
t=0.3 move 0.46 0.6 over 1.0
t=2.6 down left
t=2.75 up left
t=3.0 caption Slice (default)
t=6.0 caption M: 4D eye
t=6.0 cycle
t=9.0 caption M: back to slice
t=9.0 cycle
