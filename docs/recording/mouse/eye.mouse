# Scripted mouse for the eye reel (--mouse-script); see docs/controls.md
t=0 view eye
t=0 move 0.5 0.55
t=0 caption Mouse: aim the drop
t=0.2 move 0.43 0.57 over 1.2
t=1.6 caption Left click: drop the fruit
t=1.8 down left
t=1.95 up left
t=2.5 caption Wheel: set the drop's w
t=2.70 scroll 1
t=3.00 scroll 1
t=3.30 scroll 1
t=3.60 scroll 1
t=4.2 down left
t=4.35 up left
t=4.8 caption Wheel the other way: drop on the far side in w
t=5.00 scroll -1
t=5.30 scroll -1
t=5.60 scroll -1
t=5.90 scroll -1
t=6.20 scroll -1
t=6.50 scroll -1
t=7.0 down left
t=7.15 up left
t=7.5 caption Shift+right-drag: turn into 4D
t=7.5 mods shift
t=7.6 down right
t=7.7 move 0.62 0.5 over 1.4
t=9.1 up right
t=9.2 mods none
